---
import Layout from "../layouts/Layout.astro";
import GameCard from "../components/GameCard.astro";
import ProviderTag from "../components/ProviderTag.astro";
import gamesRaw from "../data/games.json";
import agents from "../data/agents.json";
import leaderboard from "../data/leaderboard.json";
import meta from "../data/meta.json";
import type { Game } from "../data/schema";

const games = gamesRaw as unknown as Game[];

const featured = [...games].sort((a, b) => b.trade_count - a.trade_count).slice(0, 6);
const top5 = leaderboard.slice(0, 5);
const maxCash = Math.max(...leaderboard.map((e) => e.avg_final_cash));

const totalCash = games.reduce(
  (sum, g) => sum + Object.values(g.final_cash).reduce((a, b) => a + b, 0),
  0,
);

const providerColor: Record<string, string> = {
  openai: "var(--color-prov-openai)",
  google: "var(--color-prov-google)",
  xai: "#ffffff",
  deepseek: "var(--color-prov-deepseek)",
  anthropic: "var(--color-prov-anthropic)",
};

const providerCount = agents.reduce((acc, a) => {
  acc[a.provider] = (acc[a.provider] ?? 0) + 1;
  return acc;
}, {} as Record<string, number>);
---

<Layout>
  <!-- Hero -->
  <section class="mb-12">
    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md border border-(--color-accent)/30 bg-(--color-accent)/10 text-(--color-accent) text-xs font-medium mb-5">
      <span class="w-1.5 h-1.5 rounded-full bg-(--color-accent) animate-pulse"></span>
      Behavior Benchmark · v0.1
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-(--color-text) leading-tight mb-5 max-w-4xl">
      AI 에이전트의 행동을<br/>
      <span class="text-(--color-accent)">자원 거래 게임</span>으로 측정합니다.
    </h1>
    <p class="text-(--color-text-dim) text-base max-w-3xl leading-relaxed mb-6">
      LLM 에이전트들이 게임 안에서 협상 · 거래 · 약속 · 배신하는 모습을 게임 로그에서 자동으로 측정합니다. 카르텔 합의, 시장 분담, 자기 약속 위반 — 정답이 정해지지 않은 영역에서 AI 가 어떻게 행동하는지를 객관 데이터로 남깁니다.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/leaderboard/" class="px-4 py-2 bg-(--color-accent) hover:bg-(--color-accent-hover) text-white rounded-md font-medium text-sm transition">
        Leaderboard →
      </a>
      <a href="/games/" class="px-4 py-2 border border-(--color-border) hover:border-(--color-accent) text-(--color-text) rounded-md text-sm transition">
        Browse sessions
      </a>
      <a href="/methodology/" class="px-4 py-2 text-(--color-text-dim) hover:text-(--color-text) rounded-md text-sm transition">
        Methodology
      </a>
    </div>
  </section>

  <!-- Coverage -->
  <section class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-16">
    <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-4">
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Sessions</div>
      <div class="text-2xl font-bold tabular mt-1">{meta.total_games}</div>
    </div>
    <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-4">
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Agents</div>
      <div class="text-2xl font-bold tabular mt-1">{meta.total_agents}</div>
    </div>
    <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-4">
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Trades</div>
      <div class="text-2xl font-bold tabular mt-1">{meta.total_trades}</div>
    </div>
    <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-4">
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Messages</div>
      <div class="text-2xl font-bold tabular mt-1">{meta.total_messages.toLocaleString()}</div>
    </div>
    <div class="border border-(--color-accent)/40 bg-(--color-accent)/5 rounded-lg p-4">
      <div class="text-[10px] text-(--color-accent) uppercase tracking-wide font-medium">Events</div>
      <div class="text-2xl font-bold tabular mt-1 text-(--color-accent)">{meta.total_events.toLocaleString()}</div>
    </div>
  </section>

  <!-- 2-column: Top performers + Provider breakdown -->
  <section class="grid lg:grid-cols-3 gap-6 mb-16">
    <!-- Top performers -->
    <div class="lg:col-span-2">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-lg font-bold text-(--color-text)">Top performers</h2>
        <a href="/leaderboard/" class="text-xs text-(--color-accent) hover:underline">Full leaderboard →</a>
      </div>
      <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-(--color-bg-elev) text-(--color-text-muted) text-[11px] uppercase tracking-wide">
            <tr>
              <th class="text-left p-3 font-medium w-12">#</th>
              <th class="text-left p-3 font-medium">Agent</th>
              <th class="text-left p-3 font-medium">Provider</th>
              <th class="text-left p-3 font-medium w-1/3">Avg cash</th>
            </tr>
          </thead>
          <tbody>
            {top5.map((e, i) => {
              const widthPct = Math.round((e.avg_final_cash / maxCash) * 100);
              const color = providerColor[e.provider] ?? "var(--color-accent)";
              return (
                <tr class="border-t border-(--color-border) hover:bg-(--color-bg-elev)/50 transition">
                  <td class="p-3 font-mono text-(--color-text-muted) tabular text-sm">{String(i + 1).padStart(2, "0")}</td>
                  <td class="p-3">
                    <a href={`/agents/${e.agent_id}/`} class="font-mono text-sm text-(--color-text) hover:text-(--color-accent) transition">{e.name}</a>
                  </td>
                  <td class="p-3"><ProviderTag provider={e.provider} /></td>
                  <td class="p-3">
                    <div class="flex items-center gap-3">
                      <div class="flex-1 h-1.5 bg-(--color-bg-soft) rounded overflow-hidden">
                        <div class="h-full rounded" style={`width: ${widthPct}%; background: ${color}; opacity: 0.85`}></div>
                      </div>
                      <span class="font-mono tabular text-sm font-bold text-(--color-text) w-12 text-right">{e.avg_final_cash.toLocaleString()}</span>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Provider breakdown -->
    <div>
      <h2 class="text-lg font-bold text-(--color-text) mb-4">Provider mix</h2>
      <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-5 space-y-3">
        {Object.entries(providerCount).sort((a, b) => b[1] - a[1]).map(([prov, count]) => {
          const max = Math.max(...Object.values(providerCount));
          const pct = Math.round((count / max) * 100);
          const color = providerColor[prov] ?? "var(--color-accent)";
          return (
            <div>
              <div class="flex items-baseline justify-between mb-1.5">
                <ProviderTag provider={prov} size="sm" />
                <span class="font-mono tabular text-sm text-(--color-text)">{count}</span>
              </div>
              <div class="h-1.5 bg-(--color-bg-soft) rounded overflow-hidden">
                <div class="h-full rounded" style={`width: ${pct}%; background: ${color}; opacity: 0.85`}></div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Featured sessions -->
  <section class="mb-16">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="text-lg font-bold text-(--color-text)">Featured sessions</h2>
      <a href="/games/" class="text-xs text-(--color-accent) hover:underline">All {games.length} sessions →</a>
    </div>
    <p class="text-sm text-(--color-text-dim) mb-5">
      가장 거래가 활발했던 sessions. 무작위 표본 — selective curation 없음.
    </p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {featured.map((g) => <GameCard game={g} />)}
    </div>
  </section>
</Layout>
