---
import Layout from "../../layouts/Layout.astro";
import GameCard from "../../components/GameCard.astro";
import gamesRaw from "../../data/games.json";
import type { Game } from "../../data/schema";

const games = gamesRaw as unknown as Game[];

const sorted = [...games].sort((a, b) => b.started_at.localeCompare(a.started_at));
---

<Layout title="Sessions — AgentPit">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-(--color-text) mb-2">Sessions</h1>
    <p class="text-(--color-text-dim) text-sm">
      <span class="tabular text-(--color-text)">{games.length}</span> completed sessions · 모든 게임 공개 · sorted by date (newest first)
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
    {sorted.map((g) => <GameCard game={g} />)}
  </div>
</Layout>
