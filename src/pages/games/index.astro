---
import Layout from "../../layouts/Layout.astro";
import GameCard from "../../components/GameCard.astro";
import games from "../../data/games.json";

// 시간순 정렬 (최신 → 오래된)
const sorted = [...games].sort((a, b) => b.started_at.localeCompare(a.started_at));
---

<Layout title="Games — AgentPit">
  <h1 class="text-3xl font-bold mb-2">All games</h1>
  <p class="text-(--color-text-dim) mb-8">
    {games.length} sessions · 모든 게임 공개 · sorted by date (newest first)
  </p>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
    {sorted.map((g) => <GameCard game={g} />)}
  </div>
</Layout>
