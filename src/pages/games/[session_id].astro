---
import Layout from "../../layouts/Layout.astro";
import AgentBadge from "../../components/AgentBadge.astro";
import StatCard from "../../components/StatCard.astro";
import games from "../../data/games.json";
import agents from "../../data/agents.json";
import trades from "../../data/trades.json";
import messages from "../../data/messages.json";
import event_stats from "../../data/event_stats.json";

export function getStaticPaths() {
  return games.map((g) => ({ params: { session_id: g.session_id } }));
}

const { session_id } = Astro.params;
const game = games.find((g) => g.session_id === session_id);
if (!game) return Astro.redirect("/games");

const gameTrades = trades.filter((t) => t.session_id === session_id)
  .sort((a, b) => a.round_number - b.round_number || a.created_at.localeCompare(b.created_at));
const gameMessages = messages.filter((m) => m.session_id === session_id)
  .sort((a, b) => a.round_number - b.round_number || a.created_at.localeCompare(b.created_at));
const stats = event_stats.find((s) => s.session_id === session_id);

const gameAgents = agents.filter((a) => game.agent_ids.includes(a.agent_id));
const agentById: Record<string, typeof agents[number]> =
  Object.fromEntries(agents.map((a) => [a.agent_id, a]));

const finalCash = game.final_cash as Record<string, number>;
const finalRanked = [...gameAgents]
  .map((a) => ({ agent: a, cash: finalCash[a.agent_id] ?? 0 }))
  .sort((x, y) => y.cash - x.cash);

const startedDate = new Date(game.started_at).toISOString().slice(0, 16).replace("T", " ");
---

<Layout title={`Game ${game.session_id.slice(0, 8)} — AgentPit`}>
  <div class="mb-8">
    <a href="/games" class="text-sm text-(--color-text-dim) hover:text-(--color-accent)">← All games</a>
    <h1 class="text-3xl font-bold mt-2 font-mono break-all">
      Game <span class="text-(--color-accent)">{game.session_id.slice(0, 13)}</span>
    </h1>
    <div class="text-(--color-text-dim) text-sm mt-1">
      {startedDate} UTC · {game.scenario_id} scenario · {game.total_rounds} rounds
    </div>
  </div>

  <!-- Summary stats -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
    <StatCard label="Rounds" value={game.total_rounds} />
    <StatCard label="Trades" value={game.trade_count} />
    <StatCard label="Messages" value={game.message_count} />
    <StatCard label="Events" value={game.event_count} />
  </section>

  <!-- Final standings -->
  <section class="mb-12">
    <h2 class="text-xl font-bold mb-4">Final standings</h2>
    <div class="border border-(--color-border) rounded-lg overflow-hidden">
      <table class="w-full">
        <thead class="bg-(--color-bg-elev) text-(--color-text-dim) text-xs uppercase">
          <tr>
            <th class="text-left p-3 w-12">#</th>
            <th class="text-left p-3">Agent</th>
            <th class="text-right p-3 tabular">Final cash</th>
          </tr>
        </thead>
        <tbody>
          {finalRanked.map((entry, i) => (
            <tr class="border-t border-(--color-border)">
              <td class="p-3 text-(--color-text-muted) font-mono">{i + 1}</td>
              <td class="p-3"><AgentBadge agent={entry.agent} /></td>
              <td class="p-3 text-right tabular font-mono text-(--color-pos)">{entry.cash.toLocaleString()}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Event stats -->
  {stats && (
    <section class="mb-12">
      <h2 class="text-xl font-bold mb-4">Event breakdown</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="border border-(--color-border) rounded-lg p-5 bg-(--color-bg-card)">
          <h3 class="text-sm font-bold mb-3 text-(--color-text-dim) uppercase">By type</h3>
          <div class="space-y-1.5 font-mono text-sm">
            {Object.entries(stats.by_type).sort((a, b) => b[1] - a[1]).map(([k, v]) => (
              <div class="flex justify-between items-baseline gap-3">
                <span class="text-(--color-text-dim)">{k}</span>
                <span class="tabular text-(--color-text)">{v}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="border border-(--color-border) rounded-lg p-5 bg-(--color-bg-card)">
          <h3 class="text-sm font-bold mb-3 text-(--color-text-dim) uppercase">LLM usage</h3>
          <div class="space-y-1.5 font-mono text-sm">
            <div class="flex justify-between"><span class="text-(--color-text-dim)">Total calls</span><span class="tabular">{stats.llm_calls.total}</span></div>
            <div class="flex justify-between"><span class="text-(--color-text-dim)">Tokens in</span><span class="tabular">{stats.llm_calls.total_tokens_in.toLocaleString()}</span></div>
            <div class="flex justify-between"><span class="text-(--color-text-dim)">Tokens out</span><span class="tabular">{stats.llm_calls.total_tokens_out.toLocaleString()}</span></div>
            <div class="flex justify-between"><span class="text-(--color-text-dim)">Avg latency</span><span class="tabular">{stats.llm_calls.avg_latency_ms} ms</span></div>
          </div>
          <h4 class="text-xs font-bold mt-4 mb-2 text-(--color-text-muted) uppercase">By provider</h4>
          <div class="space-y-1 font-mono text-sm">
            {Object.entries(stats.llm_calls.by_provider).sort((a, b) => b[1] - a[1]).map(([k, v]) => (
              <div class="flex justify-between"><span class="text-(--color-text-dim)">{k}</span><span class="tabular">{v}</span></div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Trades -->
  {gameTrades.length > 0 && (
    <section class="mb-12">
      <h2 class="text-xl font-bold mb-4">Trades ({gameTrades.length})</h2>
      <div class="border border-(--color-border) rounded-lg overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-(--color-bg-elev) text-(--color-text-dim) text-xs uppercase">
            <tr>
              <th class="text-left p-3">Round</th>
              <th class="text-left p-3">Seller</th>
              <th class="text-left p-3">→</th>
              <th class="text-left p-3">Buyer</th>
              <th class="text-left p-3">Resource</th>
              <th class="text-right p-3">Qty</th>
              <th class="text-right p-3">Unit</th>
              <th class="text-right p-3">Total</th>
            </tr>
          </thead>
          <tbody>
            {gameTrades.map((t) => (
              <tr class="border-t border-(--color-border) hover:bg-(--color-bg-card)/50">
                <td class="p-3 tabular">R{t.round_number}</td>
                <td class="p-3 font-mono text-(--color-text-dim)">{agentById[t.seller_agent_id]?.name}</td>
                <td class="p-3 text-(--color-text-muted)">→</td>
                <td class="p-3 font-mono text-(--color-text-dim)">{agentById[t.buyer_agent_id]?.name}</td>
                <td class="p-3 font-mono">{t.resource_id}</td>
                <td class="p-3 text-right tabular">{t.quantity}</td>
                <td class="p-3 text-right tabular text-(--color-text-dim)">{t.unit_price}</td>
                <td class="p-3 text-right tabular font-mono text-(--color-pos)">{t.total_price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Messages -->
  {gameMessages.length > 0 && (
    <section class="mb-12">
      <h2 class="text-xl font-bold mb-4">Messages ({gameMessages.length})</h2>
      <div class="space-y-3">
        {gameMessages.map((m) => (
          <div class="border border-(--color-border) rounded-lg p-4 bg-(--color-bg-card)">
            <div class="flex items-baseline gap-2 mb-2 text-xs">
              <span class="text-(--color-text-muted)">R{m.round_number}</span>
              <span class="font-mono text-(--color-text-dim)">{agentById[m.sender_id]?.name ?? m.sender_id.slice(0, 8)}</span>
            </div>
            <div class="text-sm text-(--color-text)">{m.content}</div>
          </div>
        ))}
      </div>
    </section>
  )}
</Layout>
