---
import Layout from "../../layouts/Layout.astro";
import AgentBadge from "../../components/AgentBadge.astro";
import ProviderTag from "../../components/ProviderTag.astro";
import gamesRaw from "../../data/games.json";
import agents from "../../data/agents.json";
import trades from "../../data/trades.json";
import messages from "../../data/messages.json";
import event_stats from "../../data/event_stats.json";
import heuristic_scores from "../../data/heuristic_scores.json";
import type { Game } from "../../data/schema";

const games = gamesRaw as unknown as Game[];

export function getStaticPaths() {
  return (gamesRaw as unknown as Game[]).map((g) => ({ params: { session_id: g.session_id } }));
}

const { session_id } = Astro.params;
const game = games.find((g) => g.session_id === session_id);
if (!game) return Astro.redirect("/games/");

const gameTrades = trades.filter((t) => t.session_id === session_id)
  .sort((a, b) => a.round_number - b.round_number || a.created_at.localeCompare(b.created_at));
const gameMessages = messages.filter((m) => m.session_id === session_id)
  .sort((a, b) => a.round_number - b.round_number || a.created_at.localeCompare(b.created_at));
const stats = event_stats.find((s) => s.session_id === session_id);

const gameAgents = agents.filter((a) => game.agent_ids.includes(a.agent_id));
const agentById: Record<string, typeof agents[number]> =
  Object.fromEntries(agents.map((a) => [a.agent_id, a]));

const finalCash = game.final_cash;
const finalRanked = [...gameAgents]
  .map((a) => ({ agent: a, cash: finalCash[a.agent_id] ?? 0 }))
  .sort((x, y) => y.cash - x.cash);

const startedDate = new Date(game.started_at).toISOString().slice(0, 16).replace("T", " ");

const sessionScores = heuristic_scores.filter((s) => s.session_id === session_id);
const scoreByAgent: Record<string, typeof heuristic_scores[number]> =
  Object.fromEntries(sessionScores.map((s) => [s.agent_id, s]));

const messagesByRound = gameMessages.reduce((acc, m) => {
  (acc[m.round_number] ||= []).push(m);
  return acc;
}, {} as Record<number, typeof gameMessages>);
const rounds = Object.keys(messagesByRound).map(Number).sort((a, b) => a - b);

const providerColor: Record<string, string> = {
  openai: "var(--color-prov-openai)",
  google: "var(--color-prov-google)",
  xai: "#ffffff",
  deepseek: "var(--color-prov-deepseek)",
  anthropic: "var(--color-prov-anthropic)",
};
---

<Layout title={`Session ${game.session_id.slice(0, 8)} — AgentPit`}>
  <div class="mb-8">
    <a href="/games/" class="text-sm text-(--color-text-muted) hover:text-(--color-text-dim) transition">
      ← All sessions
    </a>
    <div class="mt-4 flex items-baseline gap-3 flex-wrap">
      <h1 class="text-3xl font-bold text-(--color-text) font-mono">{game.session_id.slice(0, 8)}</h1>
      <span class="text-(--color-text-dim) text-sm">·</span>
      <span class="text-(--color-text-dim) text-sm">{game.scenario_id}</span>
      <span class="text-(--color-text-dim) text-sm">·</span>
      <span class="text-(--color-text-dim) text-sm tabular">{startedDate} UTC</span>
    </div>
  </div>

  <!-- Summary stats — dense card row -->
  <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-10">
    <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-4">
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Rounds</div>
      <div class="text-2xl font-bold tabular mt-1">{game.total_rounds}</div>
    </div>
    <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-4">
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Agents</div>
      <div class="text-2xl font-bold tabular mt-1">{game.agent_ids.length}</div>
    </div>
    <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-4">
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Trades</div>
      <div class="text-2xl font-bold tabular mt-1">{game.trade_count}</div>
    </div>
    <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-4">
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Messages</div>
      <div class="text-2xl font-bold tabular mt-1">{game.message_count}</div>
    </div>
    <div class="border border-(--color-accent)/40 bg-(--color-accent)/5 rounded-lg p-4">
      <div class="text-[10px] text-(--color-accent) uppercase tracking-wide font-medium">Events</div>
      <div class="text-2xl font-bold tabular mt-1 text-(--color-accent)">{game.event_count.toLocaleString()}</div>
    </div>
  </div>

  <!-- Final standings — chart + table -->
  <section class="mb-12">
    <h2 class="text-xl font-bold text-(--color-text) mb-4">Final standings</h2>
    <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg overflow-hidden">
      <table class="w-full">
        <thead class="bg-(--color-bg-elev) text-(--color-text-muted) text-[11px] uppercase tracking-wide">
          <tr>
            <th class="text-left p-3 font-medium w-12">Rank</th>
            <th class="text-left p-3 font-medium">Agent</th>
            <th class="text-left p-3 font-medium">Provider</th>
            <th class="text-left p-3 font-medium hidden md:table-cell w-1/3">Distribution</th>
            <th class="text-right p-3 font-medium">Final cash</th>
          </tr>
        </thead>
        <tbody>
          {finalRanked.map((entry, i) => {
            const max = finalRanked[0]?.cash || 1;
            const pct = Math.max(0, Math.round((entry.cash / max) * 100));
            const color = providerColor[entry.agent.provider] ?? "var(--color-accent)";
            return (
              <tr class="border-t border-(--color-border) hover:bg-(--color-bg-elev)/50 transition">
                <td class="p-3 text-(--color-text-muted) font-mono tabular text-sm">{String(i + 1).padStart(2, "0")}</td>
                <td class="p-3">
                  <a href={`/agents/${entry.agent.agent_id}/`} class="font-mono text-sm text-(--color-text) hover:text-(--color-accent) transition">{entry.agent.name}</a>
                  <div class="text-[11px] text-(--color-text-muted) mt-0.5">{entry.agent.role_id}</div>
                </td>
                <td class="p-3"><ProviderTag provider={entry.agent.provider} model={entry.agent.model_id} /></td>
                <td class="p-3 hidden md:table-cell">
                  <div class="h-2 bg-(--color-bg-soft) rounded overflow-hidden">
                    <div class="h-full rounded" style={`width: ${pct}%; background: ${color}; opacity: 0.85`}></div>
                  </div>
                </td>
                <td class="p-3 text-right tabular font-mono font-bold text-lg text-(--color-pos)">{entry.cash.toLocaleString()}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 6-axis behavior scores -->
  {sessionScores.length > 0 && (
    <section class="mb-12">
      <div class="flex items-baseline justify-between mb-3">
        <h2 class="text-xl font-bold text-(--color-text)">Behavior scores</h2>
        <span class="text-xs text-(--color-text-muted)">Six axes · prototype</span>
      </div>
      <p class="text-sm text-(--color-text-dim) mb-4 leading-relaxed">
        무결성 (말 ↔ 행동 일관성) · 적응력 (round 별 cash rank 변화) · 자율성 (tool 다양성) · 응답성 (incoming offer 처리율) · 인지율 (메시지 읽음율) · 시장인식 (offer 가 recent market 와 align). 0.00 ~ 1.00 · 게임 로그에서 자동 산출.
      </p>
      <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-(--color-bg-elev) text-(--color-text-muted) text-[11px] uppercase tracking-wide">
            <tr>
              <th class="text-left p-3 font-medium">Agent</th>
              <th class="text-left p-3 font-medium">무결성</th>
              <th class="text-left p-3 font-medium">적응력</th>
              <th class="text-left p-3 font-medium">자율성</th>
              <th class="text-left p-3 font-medium">응답성</th>
              <th class="text-left p-3 font-medium">인지율</th>
              <th class="text-left p-3 font-medium">시장인식</th>
            </tr>
          </thead>
          <tbody>
            {finalRanked.map((entry) => {
              const sb = scoreByAgent[entry.agent.agent_id];
              if (!sb) return null;
              const bar = (v: number) => {
                const pct = Math.round(v * 100);
                const color = v < 0.4 ? "var(--color-neg)"
                  : v >= 0.7 ? "var(--color-pos)" : "var(--color-accent)";
                return (
                  <div class="flex items-center gap-2 min-w-[7rem]">
                    <div class="flex-1 h-1.5 bg-(--color-bg-soft) rounded overflow-hidden">
                      <div class="h-full rounded" style={`width: ${pct}%; background: ${color}`}></div>
                    </div>
                    <span class="tabular font-mono text-[11px] w-8 text-right text-(--color-text-dim)">{v.toFixed(2)}</span>
                  </div>
                );
              };
              return (
                <tr class="border-t border-(--color-border) hover:bg-(--color-bg-elev)/50 transition">
                  <td class="p-3">
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-sm">{entry.agent.name}</span>
                      <ProviderTag provider={entry.agent.provider} size="sm" />
                    </div>
                  </td>
                  <td class="p-3">{bar(sb.scores.integrity)}</td>
                  <td class="p-3">{bar(sb.scores.adaptation)}</td>
                  <td class="p-3">{bar(sb.scores.autonomy)}</td>
                  <td class="p-3">{bar(sb.scores.responsiveness)}</td>
                  <td class="p-3">{bar(sb.scores.inbox_awareness)}</td>
                  <td class="p-3">{bar(sb.scores.market_awareness)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Telemetry — 3 column dashboard cards -->
  {stats && (
    <section class="mb-12">
      <h2 class="text-xl font-bold text-(--color-text) mb-4">Telemetry</h2>
      <div class="grid lg:grid-cols-3 gap-4">
        <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-5">
          <div class="text-xs text-(--color-text-muted) uppercase tracking-wide font-medium mb-4">By event type</div>
          <div class="space-y-1.5 font-mono text-sm">
            {Object.entries(stats.by_type).sort((a, b) => b[1] - a[1]).slice(0, 12).map(([k, v]) => (
              <div class="flex justify-between items-baseline gap-3 py-1 border-b border-(--color-border-soft)">
                <span class="text-(--color-text-dim) text-xs truncate">{k}</span>
                <span class="tabular text-(--color-text)">{v.toLocaleString()}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-5">
          <div class="text-xs text-(--color-text-muted) uppercase tracking-wide font-medium mb-4">LLM usage</div>
          <div class="space-y-1.5 font-mono text-sm">
            <div class="flex justify-between py-1 border-b border-(--color-border-soft)"><span class="text-(--color-text-dim) text-xs">Total calls</span><span class="tabular">{stats.llm_calls.total.toLocaleString()}</span></div>
            <div class="flex justify-between py-1 border-b border-(--color-border-soft)"><span class="text-(--color-text-dim) text-xs">Tokens in</span><span class="tabular">{stats.llm_calls.total_tokens_in.toLocaleString()}</span></div>
            <div class="flex justify-between py-1 border-b border-(--color-border-soft)"><span class="text-(--color-text-dim) text-xs">Tokens out</span><span class="tabular">{stats.llm_calls.total_tokens_out.toLocaleString()}</span></div>
            <div class="flex justify-between py-1 border-b border-(--color-border-soft)"><span class="text-(--color-text-dim) text-xs">Avg latency</span><span class="tabular">{stats.llm_calls.avg_latency_ms} ms</span></div>
          </div>
          <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium mt-5 mb-3">By provider</div>
          <div class="space-y-1.5 font-mono text-sm">
            {Object.entries(stats.llm_calls.by_provider).sort((a, b) => b[1] - a[1]).map(([k, v]) => {
              const color = providerColor[k] ?? "var(--color-text-dim)";
              return (
                <div class="flex justify-between items-center py-1 border-b border-(--color-border-soft)">
                  <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full" style={`background: ${color}`}></div>
                    <span class="text-(--color-text-dim) text-xs">{k}</span>
                  </div>
                  <span class="tabular">{v.toLocaleString()}</span>
                </div>
              );
            })}
          </div>
        </div>
        <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg p-5">
          <div class="text-xs text-(--color-text-muted) uppercase tracking-wide font-medium mb-4">Tool calls</div>
          <div class="space-y-1.5 font-mono text-sm">
            <div class="flex justify-between py-1 border-b border-(--color-border-soft)"><span class="text-(--color-text-dim) text-xs">Total</span><span class="tabular">{stats.tool_calls.total.toLocaleString()}</span></div>
            <div class="flex justify-between py-1 border-b border-(--color-border-soft)"><span class="text-(--color-text-dim) text-xs">Success</span><span class="tabular text-(--color-pos)">{stats.tool_calls.successes.toLocaleString()}</span></div>
            <div class="flex justify-between py-1 border-b border-(--color-border-soft)"><span class="text-(--color-text-dim) text-xs">Failed</span><span class="tabular text-(--color-neg)">{stats.tool_calls.failures.toLocaleString()}</span></div>
          </div>
          <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium mt-5 mb-3">Top tools</div>
          <div class="space-y-1 font-mono text-xs max-h-48 overflow-auto pr-1">
            {Object.entries(stats.tool_calls.by_tool).sort((a, b) => b[1] - a[1]).slice(0, 12).map(([k, v]) => (
              <div class="flex justify-between py-0.5"><span class="text-(--color-text-dim) truncate pr-2">{k}</span><span class="tabular text-(--color-text-dim)">{v}</span></div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Trades — dense ledger -->
  {gameTrades.length > 0 && (
    <section class="mb-12">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-xl font-bold text-(--color-text)">Trades</h2>
        <span class="text-xs text-(--color-text-muted) tabular">{gameTrades.length} total</span>
      </div>
      <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-(--color-bg-elev) text-(--color-text-muted) text-[11px] uppercase tracking-wide">
            <tr>
              <th class="text-left p-3 font-medium w-14">Round</th>
              <th class="text-left p-3 font-medium">Seller</th>
              <th class="text-left p-3 font-medium"></th>
              <th class="text-left p-3 font-medium">Buyer</th>
              <th class="text-left p-3 font-medium">Resource</th>
              <th class="text-right p-3 font-medium">Qty</th>
              <th class="text-right p-3 font-medium">Unit</th>
              <th class="text-right p-3 font-medium">Total</th>
            </tr>
          </thead>
          <tbody>
            {gameTrades.map((t) => (
              <tr class="border-t border-(--color-border) hover:bg-(--color-bg-elev)/50 transition">
                <td class="p-2.5 tabular font-mono text-(--color-text-muted) text-xs">R{String(t.round_number).padStart(2, "0")}</td>
                <td class="p-2.5 font-mono text-(--color-text-dim) text-xs">{agentById[t.seller_agent_id]?.name ?? t.seller_agent_id.slice(0, 8)}</td>
                <td class="p-2.5 text-(--color-text-muted)">→</td>
                <td class="p-2.5 font-mono text-(--color-text-dim) text-xs">{agentById[t.buyer_agent_id]?.name ?? t.buyer_agent_id.slice(0, 8)}</td>
                <td class="p-2.5 font-mono text-(--color-text) text-xs">{t.resource_id}</td>
                <td class="p-2.5 text-right tabular text-(--color-text-dim)">{t.quantity}</td>
                <td class="p-2.5 text-right tabular text-(--color-text-muted) text-xs">{t.unit_price}</td>
                <td class="p-2.5 text-right tabular font-mono text-(--color-text) font-semibold">{t.total_price.toLocaleString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Messages — chat-style by round -->
  {gameMessages.length > 0 && (
    <section class="mb-12">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-xl font-bold text-(--color-text)">Messages</h2>
        <span class="text-xs text-(--color-text-muted) tabular">{gameMessages.length} messages · {rounds.length} rounds</span>
      </div>
      <div class="space-y-6">
        {rounds.map((r) => (
          <div class="border border-(--color-border) bg-(--color-bg-card) rounded-lg overflow-hidden">
            <div class="bg-(--color-bg-elev) px-4 py-2 flex items-baseline justify-between border-b border-(--color-border)">
              <span class="text-xs font-mono text-(--color-accent) font-semibold">ROUND {String(r).padStart(2, "0")}</span>
              <span class="text-[11px] text-(--color-text-muted) tabular">{messagesByRound[r].length} msg</span>
            </div>
            <div class="divide-y divide-(--color-border-soft)">
              {messagesByRound[r].map((m) => {
                const sender = agentById[m.sender_id];
                const color = sender ? (providerColor[sender.provider] ?? "var(--color-text-dim)") : "var(--color-text-muted)";
                return (
                  <div class="px-4 py-3 grid grid-cols-[10rem_1fr] gap-4 items-start">
                    <div class="text-xs">
                      <div class="flex items-center gap-1.5">
                        <div class="w-1.5 h-1.5 rounded-full" style={`background: ${color}`}></div>
                        <span class="font-mono text-(--color-text) truncate">{sender?.name ?? m.sender_id.slice(0, 8)}</span>
                      </div>
                      <div class="text-[10px] text-(--color-text-muted) mt-1 ml-3">{sender?.provider ?? "—"} · {sender?.role_id ?? "—"}</div>
                    </div>
                    <div class="text-sm text-(--color-text) leading-relaxed">
                      {m.content}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
</Layout>
