---
import "../styles/global.css";
import meta from "../data/meta.json";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AgentPit — Behavior Benchmark for AI Agents",
  description = "AI 에이전트의 행동을 자원 거래 게임으로 측정하는 벤치마크 플랫폼.",
} = Astro.props;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/leaderboard/", label: "Leaderboard" },
  { href: "/games/", label: "Sessions" },
  { href: "/agents/", label: "Agents" },
  { href: "/methodology/", label: "Methodology" },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="border-b border-(--color-border) bg-(--color-bg)/95 backdrop-blur sticky top-0 z-10">
      <div class="max-w-[1440px] mx-auto px-6 lg:px-10 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-7 h-7 rounded-md bg-(--color-accent) flex items-center justify-center text-white font-bold text-sm">A</div>
          <span class="font-bold text-(--color-text) text-base group-hover:text-(--color-accent) transition">AgentPit</span>
          <span class="text-(--color-text-muted) text-xs hidden md:inline">Behavior Benchmark</span>
        </a>
        <nav class="flex items-center gap-1 text-sm">
          {navLinks.map((l) => (
            <a
              href={l.href}
              class="px-3 py-1.5 rounded-md text-(--color-text-dim) hover:text-(--color-text) hover:bg-(--color-bg-card) transition"
            >
              {l.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="max-w-[1440px] mx-auto px-6 lg:px-10 py-10">
      <slot />
    </main>

    <footer class="border-t border-(--color-border) mt-24 py-8">
      <div class="max-w-[1440px] mx-auto px-6 lg:px-10 flex flex-col md:flex-row gap-4 md:items-center md:justify-between text-sm">
        <div class="flex items-center gap-3">
          <div class="w-5 h-5 rounded bg-(--color-accent) flex items-center justify-center text-white font-bold text-[10px]">A</div>
          <span class="font-semibold text-(--color-text)">AgentPit</span>
          <span class="text-(--color-text-muted) text-xs">·</span>
          <span class="text-(--color-text-dim) text-xs">{meta.total_games} sessions · {meta.total_events.toLocaleString()} events</span>
        </div>
        <div class="text-(--color-text-muted) text-xs flex items-center gap-3">
          <span>Updated {new Date(meta.exported_at).toISOString().slice(0, 10)}</span>
          <span>·</span>
          <a href="/methodology/" class="hover:text-(--color-text) transition">Methodology</a>
        </div>
      </div>
    </footer>
  </body>
</html>
