---
import type { Game } from "../data/schema";

interface Props {
  game: Game;
}

const { game } = Astro.props;

const total = Object.values(game.final_cash).reduce((a, b) => a + b, 0);
const startedDate = new Date(game.started_at).toISOString().slice(0, 10);
const shortId = game.session_id.slice(0, 8);
---

<a
  href={`/games/${game.session_id}/`}
  class="block border border-(--color-border) bg-(--color-bg-card) hover:border-(--color-accent)/60 hover:bg-(--color-bg-elev) rounded-lg p-5 transition group"
>
  <div class="flex items-baseline justify-between mb-4">
    <span class="font-mono text-xs text-(--color-text-muted) group-hover:text-(--color-accent) transition">{shortId}</span>
    <span class="text-xs text-(--color-text-muted) tabular">{startedDate}</span>
  </div>

  <div class="grid grid-cols-2 gap-x-6 gap-y-3">
    <div>
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Rounds</div>
      <div class="tabular text-xl font-bold text-(--color-text) mt-0.5">{game.total_rounds}</div>
    </div>
    <div>
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Trades</div>
      <div class="tabular text-xl font-bold text-(--color-text) mt-0.5">{game.trade_count}</div>
    </div>
    <div>
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Messages</div>
      <div class="tabular text-xl font-bold text-(--color-text) mt-0.5">{game.message_count}</div>
    </div>
    <div>
      <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wide font-medium">Total cash</div>
      <div class="tabular text-xl font-bold text-(--color-pos) mt-0.5">{total.toLocaleString()}</div>
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-(--color-border-soft) flex items-center justify-between text-xs">
    <span class="text-(--color-text-muted)">{game.event_count.toLocaleString()} events</span>
    <span class="text-(--color-text-muted) group-hover:text-(--color-accent) transition">View →</span>
  </div>
</a>
